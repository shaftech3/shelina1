# ---------------------------------------------------------------------------
# Shelina frontend — example environment
#
# Copy to `.env.local` (gitignored). ONLY put public values in VITE_* vars:
# Vite inlines them into the client bundle where anyone can read them.
#
# The database URL, the session secret and all password hashes belong to the
# backend (see ../shelina-api/.env.example) and must NEVER appear here.
# ---------------------------------------------------------------------------

# Base URL of the Shelina API.
# Leave as /api to use the dev-server proxy (recommended: keeps the browser on
# one origin, so no CORS preflight and no hardcoded host).
# Set to an absolute URL (e.g. https://api.shelina.pk/api) when the API is
# deployed on its own domain.
VITE_API_BASE_URL=/api
