# ---------------------------------------------------------------------------
# Shelina API — example environment
#
# Copy to `.env` (gitignored) and fill in real values for your machine.
# NEVER commit `.env`. None of these values are exposed to the browser: the
# frontend only receives VITE_API_BASE_URL, which is a public URL.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Server-side only — never expose to Vite.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shelina_dev?schema=public

# Secret used to sign session cookies. Must be long and random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters is enforced in production.
SESSION_SECRET=

# Comma-separated list of allowed browser origins.
# Credentials are used, so a wildcard "*" is never acceptable.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# API port.
PORT=4000

# development | production
NODE_ENV=development

# Failed auth attempts allowed per IP per 15 minutes. Leave unset in
# production (defaults to 20); raise it only for automated test runs.
AUTH_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Seed-only. Used once by `npm run seed` to create the first admin account.
# The password is hashed with bcrypt before storage and is never persisted in
# plaintext. Change it immediately in any shared environment.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@shelina.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Shelina Admin

# ── Stage 6: Cash-on-Delivery shipping ──────────────────────────────────
# Flat fee in integer PKR, and the subtotal at/above which delivery is free.
# The backend always calculates the fee from these values; the browser never
# supplies it.
SHIPPING_FEE=250
FREE_SHIPPING_THRESHOLD=5000
