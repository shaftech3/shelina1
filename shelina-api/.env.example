# ---------------------------------------------------------------------------
# Shelina API — example environment
#
# Copy to `.env` (gitignored) and fill in real values for your machine.
# NEVER commit `.env`. None of these values are exposed to the browser: the
# frontend only receives VITE_API_BASE_URL, which is a public URL.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Server-side only — never expose to Vite.
DATABASE_URL=

# Secret used to sign session cookies. Must be long and random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters is enforced in production.
SESSION_SECRET=

# Comma-separated list of allowed browser origins.
# Credentials are used, so a wildcard "*" is never acceptable.
CORS_ORIGIN=https://shelina1.vercel.app

# API port.
PORT=4000

# development | production
NODE_ENV=development

# Failed auth attempts allowed per IP per 15 minutes. Leave unset in
# production (defaults to 20); raise it only for automated test runs.
AUTH_RATE_LIMIT=20

# Single admin account configuration (environment controlled)
ADMIN_EMAIL=shelinaoffical@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=

# Seed-only (legacy aliases)
SEED_ADMIN_EMAIL=shelinaoffical@gmail.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ── Brevo SMTP Email Configuration ──────────────────────────────────────
# Credentials for real Brevo transactional email delivery.
# Server-side only — never expose to frontend or commit to version control.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# ── Persistent Media Storage Configuration (Cloudinary / Persistent Disk) ──
# Render container filesystem is ephemeral; persistent cloud storage ensures
# product images, category photos, hero banners, and videos survive restarts & redeploys.
#
# Option A: Cloudinary (Recommended: Free tier, global CDN, native video streaming)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, single URL format:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option B: Persistent Disk Mount Path (e.g. on Render Disk)
# UPLOADS_DIR=/var/data/uploads

# ── Stage 6: Cash-on-Delivery shipping ──────────────────────────────────
# Flat fee in integer PKR, and the subtotal at/above which delivery is free.
# The backend always calculates the fee from these values; the browser never
# supplies it.
SHIPPING_FEE=250
FREE_SHIPPING_THRESHOLD=5000
